<?xml version="1.0" encoding="utf-8"?>
<id.cctv.monitor.ui.AspectRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tile"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <SurfaceView
        android:id="@+id/cloudSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:id="@+id/nightLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Indikator sensor gerak + badge GERAK langsung di tampilan kamera -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSensorChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_sensor"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="SENSOR ON"
            android:textColor="@color/accent"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMotionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_badge_motion"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="GERAK"
            android:textColor="@color/black"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_gravity="bottom|start">

        <TextView
            android:id="@+id/tvCameraName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_status_online"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/black"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/bg_chip_circle"
        android:contentDescription="@string/controls"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/text" />
</id.cctv.monitor.ui.AspectRatioFrameLayout>
