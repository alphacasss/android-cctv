<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSheetSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSheetFlags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressSheet"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="TAMPILAN &amp; SENSOR"
            android:textColor="@color/muted_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBlack"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="HITAM — privacy mask"
            android:textColor="@color/text"
            app:icon="@drawable/ic_eye"
            app:iconTint="@color/text"
            app:strokeColor="@color/stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDayNight"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/day_night"
            android:textSize="14sp"
            app:strokeColor="@color/stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMovement"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/movement_detect"
            android:textSize="14sp"
            app:strokeColor="@color/stroke" />

        <TextView
            android:id="@+id/tvMovementNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/movement_detect_note"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMotionTest"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="TES SENSOR GERAK (2 SNAPSHOT)"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/tvMotionTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_chip"
            android:padding="10dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="STREAM &amp; REKAM"
            android:textColor="@color/muted_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStream"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="STOP STREAM"
            android:textColor="@color/text"
            app:icon="@drawable/ic_video"
            app:iconTint="@color/text"
            app:strokeColor="@color/stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRtsp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="RTSP OFF"
            android:textColor="@color/warning"
            app:icon="@drawable/ic_power"
            app:iconTint="@color/warning"
            app:strokeColor="@color/warning" />

        <TextView
            android:id="@+id/tvDayNightNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/day_night_note"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <!-- Pengganti IR: pencerahan gambar di aplikasi + foto/rekaman -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNightBoost"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="NIGHT BOOST (tanpa IR)"
            android:textSize="14sp"
            app:strokeColor="@color/stroke" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSnapshot"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_4"
                android:layout_weight="1"
                android:text="FOTO"
                android:textColor="@color/black"
                app:backgroundTint="@color/accent"
                app:icon="@drawable/ic_camera"
                app:iconTint="@color/black" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecord"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_4"
                android:layout_weight="1"
                android:text="REKAM"
                android:textColor="@color/black"
                app:backgroundTint="@color/status_info"
                app:icon="@drawable/ic_play"
                app:iconTint="@color/black" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNightNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Kamera tanpa IR: NIGHT BOOST mencerahkan gambar dari aplikasi. FOTO menyimpan snapshot ke galeri; REKAM menyimpan klip .ts (putar dengan VLC)."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="SISTEM"
            android:textColor="@color/muted_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLed"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="LAMPU PUTIH: ON / OFF"
            android:textSize="14sp"
            app:strokeColor="@color/stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProbe"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="CEK KEMAMPUAN KAMERA (ISAPI)"
            android:textColor="@color/accent"
            app:icon="@drawable/ic_settings"
            app:iconTint="@color/accent" />

        <TextView
            android:id="@+id/tvProbeResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_chip"
            android:padding="10dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNvr"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="KANAL STOP"
            android:textColor="@color/warning"
            app:icon="@drawable/ic_power"
            app:iconTint="@color/warning"
            app:strokeColor="@color/warning"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="Muat ulang tampilan"
            android:textColor="@color/accent"
            app:icon="@drawable/ic_refresh"
            app:iconTint="@color/accent" />

        <TextView
            android:id="@+id/tvRtspNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip"
            android:padding="10dp"
            android:text="NVR: tombol RTSP dan STOP sub-stream tidak dipakai. Mematikan RTSP NVR akan menghentikan semua kanal, jadi hanya KANAL STOP yang tersedia."
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSheetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:text="Pilih tindakan untuk kamera ini."
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="CLOUD"
            android:textColor="@color/muted_dim"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Teks harus hitam di atas background accent; sebelumnya sama-sama @color/accent sehingga tak terbaca. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBindCloud"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="BIND KE CLOUD (Hik-Connect)"
            android:textColor="@color/black"
            app:backgroundTint="@color/accent"
            app:icon="@drawable/ic_wifi"
            app:iconTint="@color/black" />
    </LinearLayout>
</ScrollView>
