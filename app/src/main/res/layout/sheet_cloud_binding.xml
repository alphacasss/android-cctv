<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvCloudTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CLOUD HIK-CONNECT"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCloudSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Impor nama, kanal, dan status kamera dari akun Hik-Connect. Saat di luar jaringan, live stream diputar lewat relay P2P cloud tanpa port forwarding."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvCloudAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Email Hik-Connect"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Password Hik-Connect"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/tvCloudStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressCloud"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloudLogin"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="LOGIN &amp; SINKRON DEVICE"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloudSync"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="SINKRON ULANG"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCloudListTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="DEVICE &amp; KANAL TERIKAT"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCloudNoDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Belum ada device. Login dulu untuk sinkronisasi."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/rvCloudDevices"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:divider="@color/stroke"
            android:dividerHeight="1dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etStreamUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="URL stream opsional (rtsp://… atau https://…)"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etVerification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Kode verifikasi perangkat (label NVR, 6 huruf)"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:maxLength="16"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVerificationNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Perangkat ini memakai enkripsi gambar/video. Isi kode verifikasi agar snapshot dan live stream cloud bisa didekripsi."
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloudAttach"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="BIND KE KAMERA INI"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCloudAttached"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloudUnbind"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="LEPAS BINDING CLOUD"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCloudNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Catatan: login cloud tidak membuka port atau memakai server relay. Kontrol kamera (ISAPI) tetap memerlukan akses LAN/DDNS/VPN. Snapshot cloud dipakai untuk tombol FOTO saat di luar jaringan."
            android:textColor="@color/muted"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
